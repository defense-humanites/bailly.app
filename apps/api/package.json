{
  "name": "bailly-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/node.ts",
    "start": "node src/node.ts",
    "dev:worker": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "pnpm run types && tsc --noEmit",
    "test": "vitest run --project node",
    "test:workers": "vitest run --project workers",
    "test:all": "vitest run",
    "morpheus:data": "node scripts/morpheus_data.ts",
    "d1:local": "node scripts/d1_local_import.ts",
    "d1:export": "node scripts/d1_export_sql.ts",
    "d1:measure": "node scripts/measure_d1.ts"
  },
  "dependencies": {
    "@bailly/api-types": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@humanities/greek-conversion": "catalog:",
    "@libmorpheus/wasm": "^0.1.4",
    "hono": "^4.13.17",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@libmorpheus/node": "^0.1.4",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
