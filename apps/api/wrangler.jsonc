{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bailly-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  // `api.bailly.app`: the Worker answers in place of the origin (the DNS record, still
  // proxied to Heroku, stays as it is). Removing the route gives the origin back.
  "routes": [
    {
      "pattern": "api.bailly.app/*",
      "zone_name": "bailly.app"
    }
  ],
  // No `workers.dev` address nor version URLs: the API is only reached through
  // `api.bailly.app`, behind the rules of the zone, and by the front end's service
  // binding.
  "workers_dev": false,
  "preview_urls": false,
  // Workers Cache: a cache in front of the Worker (nearest data center, then an upper
  // tier), for the responses whose `Cache-Control` allows it (cf. `CACHEABLE` in
  // `src/app.ts`), whatever the caller (browsers, the front end's service binding).
  // A response served by it runs neither the Worker nor D1. Its entries belong to a
  // version of the Worker: each deployment starts from an empty cache. Rollback:
  // `"enabled": false`, then deploy.
  "cache": { "enabled": true },
  // The dictionary (cf. `src/defaults.ts` for the revision and `README.md` for the
  // import). The scripts address it by its binding (`wrangler d1 execute DB`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bailly-dict",
      "database_id": "64c12c9d-3624-438c-8e79-5f23ba32c329"
    }
  ],
  // The stem data of Morpheus, bundled as Data modules (`ArrayBuffer`): cf.
  // `scripts/morpheus_data.ts`, which generates the imports.
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/morpheus-data/**/*.table",
        "**/morpheus-data/**/*.out",
        "**/morpheus-data/**/*.lindex",
        "**/morpheus-data/**/*.ml",
        "**/morpheus-data/**/nomind",
        "**/morpheus-data/**/vbind",
        "**/morpheus-data/**/nendind",
        "**/morpheus-data/**/vbendind",
        "**/morpheus-data/**/derivind",
        "**/morpheus-data/**/lemlist"
      ],
      "fallthrough": true
    }
  ],
  // Cf. `src/Settings.ts` (`.env.example` documents them for Node.js).
  "vars": {
    "API_ENV": "production"
  }
}
