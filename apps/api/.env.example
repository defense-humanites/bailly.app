# Overrides only: the database revision and libmorpheus paths are versioned with the
# code (cf. `src/defaults.ts`). Leave them unset in production.
#DB_FILE_PATH="database/bailly-revN.db"
#DB_VERSION="YYYY-MM-DD"
DENO_ENV="development" # Any string other than "development" activates production mode.
# libmorpheus: defaults to `vendor/…` (installed by `heroku_build.ts`); the
# `morpheus-deno` Docker image sets `/opt/morpheus/…`. In production, the API refuses to
# start without it.
#MORPHEUS_LIBRARY_PATH=vendor/morpheus-native/lib/libmorpheus.so
#MORPHEUS_STEMLIB_PATH=vendor/morpheus-data
MORPHEUS_POOL_SIZE=4
PORT=3000
QUERY_ALLOWED_FIELDS="word,uri,htmlDefinition,definition,htmlExcerpt,excerpt"
QUERY_DEFAULT_FIELDS="word,uri,excerpt"
QUERY_HEAVY_FIELDS="htmlDefinition,definition" # Fields subject to optimization.
QUERY_MAX_BATCH_SIZE=5 # @TODO replace this by independant entry/lookup max batch sizes.
#QUERY_MAX_LOOKUP_BATCH_SIZE=5
#QUERY_MAX_ENTRY_BATCH_SIZE=30
QUERY_MAX_ROWS=100