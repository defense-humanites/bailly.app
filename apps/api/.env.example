# Environment of the Node.js server (`pnpm run dev` reads `.env`); the Worker takes the
# same settings from the `vars` of `wrangler.jsonc`. Cf. `src/Settings.ts`.

# Any value other than "development" activates production mode (diagnostics off,
# batch and row limits enforced, startup refused without the Morpheus stem data).
API_ENV="development"

# Overrides only: the database revision is versioned with the code (cf.
# `src/defaults.ts`). Leave them unset in production.
#DB_FILE_PATH="database/bailly-revN.db"
#DB_VERSION="YYYY-MM-DD"

# Morpheus stem data (Node.js only), acquired by `pnpm run morpheus:data`.
#MORPHEUS_DATA_PATH="morpheus-data"

PORT=3000
QUERY_ALLOWED_FIELDS="word,uri,htmlDefinition,definition,htmlExcerpt,excerpt"
QUERY_DEFAULT_FIELDS="word,uri,excerpt"
QUERY_MAX_BATCH_SIZE=5 # @TODO replace this by independant entry/lookup max batch sizes.
QUERY_MAX_ROWS=100
