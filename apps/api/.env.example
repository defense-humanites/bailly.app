DB_FILE_PATH="database/bailly.db"
DB_VERSION="2023-02-28"
DENO_ENV="development"
MORPHEUS_BINARY_PATH="morpheus/cruncher"
MORPHEUS_LOOKUP_MAX_DURATION=250 # in milliseconds
MORPHEUS_POOL_SIZE=4
MORPHEUS_STEMLIB_PATH="morpheus/stemlib"
PORT=3000
QUERY_ALLOWED_FIELDS="word,uri,htmlDefinition,definition,htmlExcerpt,excerpt"
QUERY_DEFAULT_FIELDS="word,uri,excerpt"
QUERY_MAX_BATCH_SIZE=5
QUERY_MAX_ROWS=100