{
  "tasks": {
    "dev": "docker compose up --build --watch",
    "dev-native": "deno run --allow-env --allow-ffi --allow-net --allow-read --allow-run --allow-write --env-file=.env.development --watch src/index.ts",
    "db:pack": "deno run --allow-read=database,src --allow-write=database scripts/db_pack.ts",
    "test-native": "deno test --allow-env --allow-ffi --allow-net --allow-read --allow-run --allow-write --env-file=.env.development tests/*.test.ts"
  },
  "imports": {
    "@db/sqlite": "jsr:@db/sqlite@^0.13.0",
    "@hono/hono": "jsr:@hono/hono@^4.13.8",
    "@humanities/bailly-search-key": "jsr:@humanities/bailly-search-key@^0.2.0",
    "@humanities/greek-conversion": "jsr:@humanities/greek-conversion@1.0.0-beta.5",
    "@libmorpheus/deno": "jsr:@libmorpheus/deno@^0.4.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/streams": "jsr:@std/streams@^1.1.2",
    "@std/testing": "jsr:@std/testing@^1.0.20"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 88,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "trailingCommas": "never",
    "proseWrap": "preserve",
    "exclude": [
      "**/*.md"
    ]
  },
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "strict": true
  }
}
