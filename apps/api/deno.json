{
  "tasks": {
    "dev": "deno run --allow-env --allow-ffi --allow-net --allow-read --allow-run --allow-write --env-file=.env.development --watch src/index.ts",
    "test": "deno test --allow-env --allow-ffi --allow-net --allow-read --allow-run --allow-write --env-file tests/*.test.ts"
  },
  "imports": {
    "@db/sqlite": "jsr:@db/sqlite@^0.13.0",
    "@hono/hono": "jsr:@hono/hono@^4.12.33",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "greek-conversion": "npm:greek-conversion@^0.14.1"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 88,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "trailingCommas": "never",
    "proseWrap": "preserve",
    "exclude": [
      "**/*.md"
    ]
  },
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "strict": true
  }
}
