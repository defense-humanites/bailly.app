{
  "name": "bailly-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build && node scripts/wrangler-preview.mjs --from-build",
    "deploy:preview": "node scripts/wrangler-preview.mjs && wrangler deploy --config .output/server/wrangler.preview.json",
    "dev": "nuxt dev",
    "dev:prod-api": "NUXT_PUBLIC_API_HOST=https://api.bailly.app nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:e2e": "playwright test",
    "sync:stats": "sh scripts/sync-stats.sh",
    "sync:stats:preview": "sh scripts/sync-stats.sh preview"
  },
  "dependencies": {
    "@humanities/greek-conversion": "catalog:",
    "@nuxt/ui": "^4.12.0",
    "@pinia/nuxt": "^1.0.3",
    "@scure/bip39": "^2.4.0",
    "@vueuse/nuxt": "^15.0.0",
    "h3": "^1.15.11",
    "idb": "^8.0.4",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "tailwind-safe-insets": "^0.1.0",
    "tailwindcss": "^4.3.4",
    "uqr": "^0.1.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.150",
    "@iconify/utils": "^3.1.7",
    "@mdn/browser-compat-data": "^8.1.8",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "catalog:",
    "@vue/test-utils": "^2.5.1",
    "db0": "^0.3.4",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "typescript": "catalog:",
    "ufo": "^1.6.4",
    "vitest": "catalog:",
    "vue-tsc": "3.3.13",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
