# Settings of compose.yaml (copy to `.env`, never committed).

# The public hostnames, as routed by the tunnel (Cloudflare dashboard).
APP_HOSTNAME=bailly.example.org
API_HOSTNAME=api.bailly.example.org

# The tunnel's token (Cloudflare dashboard: Networks > Tunnels > the tunnel).
TUNNEL_TOKEN=

# Optional secret mixed in the daily pseudonyms of the visitors' addresses (budgets
# of the synchronization); any long random string, e.g. `openssl rand -hex 32`.
SYNC_ADDRESS_SECRET=
