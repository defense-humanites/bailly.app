---
import { fetchOneEntry, type ApiEntryResponse } from "../api";
import EntriesReader from "../components/EntriesReader.astro";
import { replaceBetaSymbol } from "../helpers";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = false;

/*
 * Accessed via /lecteur?q=foo,bar[&forme=…], where `forme` is the (ambiguous)
 * form whose link led to the reader (cf. `linkedEntries.ts`).
 */
const url = new URL(Astro.request.url);
const itemsParam = url.searchParams.get("q") ?? url.searchParams.get("items");
const form = url.searchParams.get("forme")?.trim().slice(0, 50) || undefined;

const itemsArray = (itemsParam ?? "")
  .split(",")
  .map((item) => item.trim())
  .filter(Boolean);

const responses: ApiEntryResponse<"word" | "uri" | "htmlDefinition" | "excerpt">[] =
  await Promise.all(
    itemsArray.map((item) =>
      fetchOneEntry(item, {
        fields: ["word", "uri", "htmlDefinition", "excerpt"]
      })
    )
  );

// Keep track of the requested entries that don't exist, so as to report them.
const entries = responses
  .map((response) => response.entry)
  .filter((entry) => Object.keys(entry).length);
const missingItems = itemsArray.filter(
  (_, i) => !Object.keys(responses[i].entry).length
);

// The reader is useless for a single entry: go to the entry page.
if (entries.length === 1 && !missingItems.length) {
  return Astro.redirect(`/${encodeURIComponent(entries[0].uri)}`);
}

const countLabel = `${entries.length} ${entries.length > 1 ? "entrées" : "entrée"}`;
const title = form ? `${replaceBetaSymbol(form)} (graphie ambiguë)` : "Lecteur";
---

<BaseLayout title={title} description="" noindex>
  <EntriesReader entries={entries}>
    <header class="mb-6 pt-6 lg:mb-0 lg:pt-0">
      {
        form ? (
          <>
            <h1 class="grec text-3xl font-bold lg:text-4xl">{form}</h1>
            <p class="mt-1 font-sans text-neutral-600 dark:text-neutral-300">
              Graphie ambiguë
              {entries.length > 1 && (
                <span class="text-neutral-500 dark:text-neutral-400">
                  {" "}· {countLabel}
                </span>
              )}
            </p>
          </>
        ) : (
          <>
            <h1 class="font-sans text-2xl font-bold lg:text-3xl">Lecteur</h1>
            {entries.length > 0 && (
              <p class="mt-1 font-sans text-neutral-500 dark:text-neutral-400">
                {countLabel}
              </p>
            )}
          </>
        )
      }
      {
        missingItems.length > 0 && (
          <p
            role="status"
            class="mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 font-sans text-sm text-red-800 dark:border-red-900/60 dark:bg-red-950/40 dark:text-red-200"
          >
            {missingItems.length > 1 ? "Entrées introuvables" : "Entrée introuvable"}&nbsp;:
            {missingItems.map((item, i) => <>{i > 0 && ", "}<span class="font-semibold">{item}</span></>)}.
          </p>
        )
      }
    </header>
  </EntriesReader>
</BaseLayout>
