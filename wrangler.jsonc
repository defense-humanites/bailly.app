{
  "name": "bailly-app-nuxt",
  // The test deployment, on `nuxt.bailly.app`, behind Cloudflare Access: no
  // `workers.dev` address nor version URLs, which the Access application of
  // `nuxt.bailly.app` does not cover.
  "routes": [
    { "pattern": "nuxt.bailly.app", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    // @TODO Preview D1 database. Change it when the `bailly-app-nuxt` repository
    // will be merged in the production `bailly-app` repository (`bailly-sync`).
    // @TODO Replace the id with that of the new database, once created
    // (`npx wrangler d1 create bailly-sync-preview`).
    {
      "binding": "SYNC_DB",
      "database_name": "bailly-sync-preview",
      "database_id": "f02a3b96-f99d-4b35-9cb2-4407a6bebffc"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "persist": true
    }
  }
}