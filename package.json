{
  "name": "bailly-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build && node scripts/wrangler-preview.mjs --from-build",
    "deploy:preview": "node scripts/wrangler-preview.mjs && wrangler deploy --config .output/server/wrangler.preview.json",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:e2e": "playwright test",
    "sync:stats": "sh scripts/sync-stats.sh",
    "sync:stats:preview": "sh scripts/sync-stats.sh preview"
  },
  "dependencies": {
    "@humanities/greek-conversion": "^1.0.0-rc.6",
    "@nuxt/ui": "^4.12.0",
    "@pinia/nuxt": "^1.0.3",
    "@scure/bip39": "^2.4.0",
    "@vueuse/nuxt": "^15.0.0",
    "h3": "^1.15.11",
    "idb": "^8.0.4",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "tailwind-safe-insets": "^0.1.0",
    "tailwindcss": "^4.3.3",
    "uqr": "^0.1.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.149",
    "@mdn/browser-compat-data": "^8.1.7",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.13",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261023.1": true
  }
}
