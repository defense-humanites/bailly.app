# Copy this file to `.env` to override the default values defined in
# `nuxt.config.ts` (`runtimeConfig.public`).

# API base URL: an absolute URL, including the scheme (e.g. http://localhost:3000).
NUXT_PUBLIC_API_HOST=https://api.bailly.app

# Development only: relays `/_api` on the dev server to this API, so that the
# browser calls the API on the app's own origin. To use it, also set
# NUXT_PUBLIC_API_HOST=http://localhost:4321/_api
# DEV_API_PROXY=http://localhost:3000

# Search bar settings.
NUXT_PUBLIC_SEARCH_DEBOUNCE_TIME=90
NUXT_PUBLIC_SEARCH_RESULTS_LENGTH=30
NUXT_PUBLIC_SEARCH_HISTORY_LENGTH=60

# Bookmarks limits.
NUXT_PUBLIC_TAG_MAX_ITEMS=100
NUXT_PUBLIC_MAX_TAGS=50
