# Copy this file to `.env` to override the default values defined in
# `nuxt.config.ts` (`runtimeConfig.public`).

# API base URL: an absolute URL, including the scheme (e.g. http://localhost:3000).
NUXT_PUBLIC_API_HOST=https://api.bailly.app

# Development only: relays `/_api` on the dev server to this API, so that the
# browser calls the API on the app's own origin. To use it, also set
# NUXT_PUBLIC_API_HOST=http://localhost:4321/_api
# DEV_API_PROXY=http://localhost:3000

# Search bar settings.
NUXT_PUBLIC_SEARCH_DEBOUNCE_TIME=90
NUXT_PUBLIC_SEARCH_RESULTS_LENGTH=30
NUXT_PUBLIC_SEARCH_HISTORY_LENGTH=60

# Bookmarks limits.
NUXT_PUBLIC_TAG_MAX_ITEMS=100
NUXT_PUBLIC_MAX_TAGS=50

# Bookmarks synchronization (server): daily budgets against abuses, per
# client address and for the whole server (0: no limit), cf.
# `server/lib/syncBudget.ts`.
# NUXT_SYNC_DAILY_BYTES=1000000
# NUXT_SYNC_DAILY_CREATIONS=100
# NUXT_SYNC_DAILY_GROWTH=5000000
# NUXT_SYNC_DAILY_TOTAL=5000000
# NUXT_SYNC_DAILY_TOTAL_ESTABLISHED=5000000
# The header giving the client's address, set by the proxy in front of the
# server (e.g. `x-forwarded-for` behind Caddy or nginx; `cf-connecting-ip`,
# set automatically, on Cloudflare). Without a proxy, leave it empty: the
# connection's address is used. Never set it without a proxy that overwrites
# it: a client could send any value.
# NUXT_SYNC_ADDRESS_HEADER=
# A secret mixed in the pseudonyms of the addresses (a secret of the Worker
# in production, e.g. `npx wrangler secret put NUXT_SYNC_ADDRESS_SECRET`).
# NUXT_SYNC_ADDRESS_SECRET=
